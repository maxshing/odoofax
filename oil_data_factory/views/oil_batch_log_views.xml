<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_oil_batch_log_form" model="ir.ui.view">
        <field name="name">oil.batch_log.form</field>
        <field name="model">oil.batch_log</field>
        <field name="arch" type="xml">
            <form string="Batch Log">
                <header>
                    <button name="action_mark_pass" string="Mark Pass" type="object" 
                            class="btn-success" invisible="qc_result != 'pending'"/>
                    <button name="action_mark_fail" string="Mark Fail" type="object" 
                            class="btn-danger" invisible="qc_result != 'pending'"/>
                    <field name="qc_result" widget="statusbar" statusbar_visible="pending,pass,fail"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-microchip"
                                name="action_view_iot_logs" type="object">
                            <field name="iot_log_count" widget="statinfo" string="IoT Records"/>
                        </button>
                    </div>
                    <group>
                        <group string="Basic Info">
                            <field name="batch_no"/>
                            <field name="product_id"/>
                            <field name="tank_id"/>
                            <field name="quantity_produced"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Time">
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration_hours"/>
                            <field name="operator"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quality Control">
                            <group>
                                <group>
                                    <field name="viscosity"/>
                                    <field name="viscosity_temp"/>
                                    <field name="density"/>
                                </group>
                                <group>
                                    <field name="moisture"/>
                                    <field name="acid_number"/>
                                    <field name="flash_point"/>
                                </group>
                            </group>
                            <group>
                                <field name="qc_notes"/>
                            </group>
                        </page>
                        <page string="SCADA Data">
                            <field name="scada_log"/>
                        </page>
                        <page string="IoT Logs">
                            <field name="iot_log_ids">
                                <list>
                                    <field name="timestamp"/>
                                    <field name="device_id"/>
                                    <field name="tag_type"/>
                                    <field name="value"/>
                                    <field name="unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_oil_batch_log_tree" model="ir.ui.view">
        <field name="name">oil.batch_log.tree</field>
        <field name="model">oil.batch_log</field>
        <field name="arch" type="xml">
            <list>
                <field name="batch_no"/>
                <field name="product_id"/>
                <field name="start_time"/>
                <field name="duration_hours"/>
                <field name="viscosity"/>
                <field name="qc_result"/>
            </list>
        </field>
    </record>

    <record id="view_oil_batch_log_search" model="ir.ui.view">
        <field name="name">oil.batch_log.search</field>
        <field name="model">oil.batch_log</field>
        <field name="arch" type="xml">
            <search>
                <field name="batch_no"/>
                <field name="product_id"/>
                <filter string="Pass" name="pass" domain="[('qc_result','=','pass')]"/>
                <filter string="Fail" name="fail" domain="[('qc_result','=','fail')]"/>
                <filter string="Pending" name="pending" domain="[('qc_result','=','pending')]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="QC Result" name="group_qc" context="{'group_by':'qc_result'}"/>
                    <filter string="Tank" name="group_tank" context="{'group_by':'tank_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_oil_batch_log" model="ir.actions.act_window">
        <field name="name">Batch Logs</field>
        <field name="res_model">oil.batch_log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
