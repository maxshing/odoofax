<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_model_registry_form" model="ir.ui.view">
        <field name="name">ai.model_registry.form</field>
        <field name="model">ai.model_registry</field>
        <field name="arch" type="xml">
            <form string="AI Model">
                <header>
                    <button name="action_deploy" string="Deploy to Production" type="object" 
                            class="btn-primary" invisible="status == 'production'"/>
                    <button name="action_deprecate" string="Deprecate" type="object" 
                            class="btn-secondary" invisible="status in ('deprecated', 'development')"/>
                    <field name="status" widget="statusbar" statusbar_visible="development,testing,production"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="version"/>
                            <field name="model_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="dataset_id"/>
                            <field name="api_endpoint"/>
                            <field name="created_date"/>
                            <field name="last_used"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                            <field name="file_size"/>
                        </group>
                        <group>
                            <field name="usage_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Metrics">
                            <field name="metrics"/>
                        </page>
                        <page string="Usage Notes">
                            <field name="usage"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_ai_model_registry_tree" model="ir.ui.view">
        <field name="name">ai.model_registry.tree</field>
        <field name="model">ai.model_registry</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="version"/>
                <field name="model_type"/>
                <field name="status"/>
                <field name="usage_count"/>
                <field name="last_used"/>
            </list>
        </field>
    </record>

    <record id="action_ai_model_registry" model="ir.actions.act_window">
        <field name="name">AI Model Registry</field>
        <field name="res_model">ai.model_registry</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
