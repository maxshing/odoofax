<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_question_log_form" model="ir.ui.view">
        <field name="name">ai.question_log.form</field>
        <field name="model">ai.question_log</field>
        <field name="arch" type="xml">
            <form string="AI Question Log">
                <sheet>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="user_id"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="confidence_score"/>
                            <field name="tokens_used"/>
                            <field name="response_time_ms"/>
                        </group>
                    </group>
                    <group string="Question">
                        <field name="question" nolabel="1"/>
                    </group>
                    <group string="Answer">
                        <field name="answer" nolabel="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="related_model"/>
                            <field name="related_record_id"/>
                            <field name="tags"/>
                        </group>
                        <group>
                            <field name="feedback"/>
                            <field name="feedback_note"/>
                        </group>
                    </group>
                    <group string="Sources Used">
                        <field name="source_ids" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_question_log_tree" model="ir.ui.view">
        <field name="name">ai.question_log.tree</field>
        <field name="model">ai.question_log</field>
        <field name="arch" type="xml">
            <list>
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="question" optional="show"/>
                <field name="category"/>
                <field name="feedback"/>
            </list>
        </field>
    </record>

    <record id="view_ai_question_log_search" model="ir.ui.view">
        <field name="name">ai.question_log.search</field>
        <field name="model">ai.question_log</field>
        <field name="arch" type="xml">
            <search>
                <field name="question"/>
                <field name="answer"/>
                <field name="user_id"/>
                <filter string="Today" name="today" domain="[('timestamp','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Helpful" name="helpful" domain="[('feedback','=','helpful')]"/>
                <filter string="Not Helpful" name="not_helpful" domain="[('feedback','in',['not_helpful','incorrect'])]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by':'user_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by':'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_question_log" model="ir.actions.act_window">
        <field name="name">AI Question Log</field>
        <field name="res_model">ai.question_log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
