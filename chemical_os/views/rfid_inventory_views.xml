<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- RFID TAG VIEWS                                               -->
    <!-- ============================================================ -->

    <!-- RFID Tag Tree View -->
    <record id="view_chemical_rfid_tag_tree" model="ir.ui.view">
        <field name="name">chemical.rfid.tag.tree</field>
        <field name="model">chemical.rfid.tag</field>
        <field name="arch" type="xml">
            <list default_order="fill_date desc">
                <field name="tag_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="quantity"/>
                <field name="fill_date"/>
                <field name="expiry_date"/>
                <field name="current_location_id"/>
                <field name="state" widget="badge" decoration-success="state in ('in_stock', 'delivered')" decoration-warning="state == 'in_transit'" decoration-info="state == 'encoded'"/>
                <field name="scan_count"/>
            </list>
        </field>
    </record>

    <!-- RFID Tag Form View -->
    <record id="view_chemical_rfid_tag_form" model="ir.ui.view">
        <field name="name">chemical.rfid.tag.form</field>
        <field name="model">chemical.rfid.tag</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="encoded,in_stock,in_transit,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="tag_id"/>
                        <h1>
                            <field name="tag_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Product Information">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="quantity"/>
                            <field name="uom_id"/>
                            <field name="container_spec_id"/>
                        </group>
                        <group string="Production">
                            <field name="production_id"/>
                            <field name="workcenter_id"/>
                            <field name="fill_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="current_location_id"/>
                        </group>
                        <group string="Tag Data">
                            <field name="tag_data"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scan History" name="scan_history">
                            <field name="scan_history_ids">
                                <list default_order="timestamp desc">
                                    <field name="timestamp"/>
                                    <field name="reader_location"/>
                                    <field name="reader_type"/>
                                    <field name="from_location_id"/>
                                    <field name="to_location_id"/>
                                    <field name="result" widget="badge"/>
                                    <field name="picking_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- RFID Tag Search View -->
    <record id="view_chemical_rfid_tag_search" model="ir.ui.view">
        <field name="name">chemical.rfid.tag.search</field>
        <field name="model">chemical.rfid.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="tag_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="production_id"/>
                <field name="current_location_id"/>
                <filter string="In Stock" name="in_stock" domain="[('state', '=', 'in_stock')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="Delivered" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter string="Expiring Soon" name="expiring" domain="[('expiry_date', '&lt;=', (context_today() + datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'current_location_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Fill Date" name="group_fill_date" context="{'group_by': 'fill_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- RFID Tag Action -->
    <record id="action_chemical_rfid_tag" model="ir.actions.act_window">
        <field name="name">RFID Tags</field>
        <field name="res_model">chemical.rfid.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_in_stock': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No RFID tags registered yet
            </p>
            <p>
                RFID tags are automatically created when drums are filled at the filling machines.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- RFID SCAN VIEWS                                              -->
    <!-- ============================================================ -->

    <!-- RFID Scan Tree View -->
    <record id="view_chemical_rfid_scan_tree" model="ir.ui.view">
        <field name="name">chemical.rfid.scan.tree</field>
        <field name="model">chemical.rfid.scan</field>
        <field name="arch" type="xml">
            <list default_order="timestamp desc">
                <field name="timestamp"/>
                <field name="tag_id"/>
                <field name="reader_location"/>
                <field name="reader_type"/>
                <field name="from_location_id"/>
                <field name="to_location_id"/>
                <field name="result" widget="badge" decoration-success="result in ('success', 'matched')" decoration-danger="result == 'error'" decoration-info="result == 'info'"/>
                <field name="picking_id"/>
            </list>
        </field>
    </record>

    <!-- RFID Scan Form View -->
    <record id="view_chemical_rfid_scan_form" model="ir.ui.view">
        <field name="name">chemical.rfid.scan.form</field>
        <field name="model">chemical.rfid.scan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Scan Details">
                            <field name="tag_id"/>
                            <field name="timestamp"/>
                            <field name="reader_location"/>
                            <field name="reader_type"/>
                        </group>
                        <group string="Location Movement">
                            <field name="from_location_id"/>
                            <field name="to_location_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Result">
                            <field name="result"/>
                            <field name="picking_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- RFID Scan Search View -->
    <record id="view_chemical_rfid_scan_search" model="ir.ui.view">
        <field name="name">chemical.rfid.scan.search</field>
        <field name="model">chemical.rfid.scan</field>
        <field name="arch" type="xml">
            <search>
                <field name="tag_id"/>
                <field name="reader_location"/>
                <field name="picking_id"/>
                <filter string="Today" name="today" domain="[('timestamp', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Success" name="success" domain="[('result', 'in', ('success', 'matched'))]"/>
                <filter string="Errors" name="errors" domain="[('result', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="Reader Location" name="group_reader" context="{'group_by': 'reader_location'}"/>
                    <filter string="Result" name="group_result" context="{'group_by': 'result'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- RFID Scan Action -->
    <record id="action_chemical_rfid_scan" model="ir.actions.act_window">
        <field name="name">RFID Scans</field>
        <field name="res_model">chemical.rfid.scan</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

</odoo>
