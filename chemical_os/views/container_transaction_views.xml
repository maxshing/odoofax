<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Container Transaction Tree View -->
    <record id="chemical_container_transaction_view_tree" model="ir.ui.view">
        <field name="name">chemical.container.transaction.view.tree</field>
        <field name="model">chemical.container.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="container_spec_id"/>
                <field name="transaction_type"/>
                <field name="direction"/>
                <field name="quantity"/>
                <field name="unit_price" optional="show"/>
                <field name="total_amount" sum="Total"/>
                <field name="balance_loaned_after"/>
                <field name="balance_customer_after"/>
                <field name="processed_by"/>
            </list>
        </field>
    </record>

    <!-- Container Transaction Form View -->
    <record id="chemical_container_transaction_view_form" model="ir.ui.view">
        <field name="name">chemical.container.transaction.view.form</field>
        <field name="model">chemical.container.transaction</field>
        <field name="arch" type="xml">
            <form string="Container Transaction" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name"/></h1>
                    </div>
                    
                    <group>
                        <group string="Transaction Details">
                            <field name="partner_id"/>
                            <field name="container_spec_id"/>
                            <field name="transaction_type"/>
                            <field name="direction"/>
                            <field name="quantity"/>
                            <field name="create_date"/>
                        </group>
                        <group string="Financial Details">
                            <field name="unit_price"/>
                            <field name="total_amount"/>
                            <field name="currency_id"/>
                            <field name="credit_note_id"/>
                            <field name="stock_move_id"/>
                        </group>
                    </group>
                    
                    <group string="Balance Changes (存摺餘額變動)">
                        <group>
                            <label string="Loaned Balance"/>
                            <div class="o_field_widget">
                                <field name="balance_loaned_before" class="oe_inline"/> 
                                <span class="mx-2">→</span>
                                <field name="balance_loaned_after" class="oe_inline"/>
                            </div>
                        </group>
                        <group>
                            <label string="Customer Balance"/>
                            <div class="o_field_widget">
                                <field name="balance_customer_before" class="oe_inline"/>
                                <span class="mx-2">→</span>
                                <field name="balance_customer_after" class="oe_inline"/>
                            </div>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                        <page string="Audit" name="audit">
                            <group>
                                <field name="processed_by"/>
                                <field name="ledger_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Container Transaction Search View -->
    <record id="chemical_container_transaction_view_search" model="ir.ui.view">
        <field name="name">chemical.container.transaction.view.search</field>
        <field name="model">chemical.container.transaction</field>
        <field name="arch" type="xml">
            <search string="Container Transactions">
                <field name="partner_id"/>
                <field name="container_spec_id"/>
                <field name="transaction_type"/>
                <separator/>
                <filter string="Buyback" name="filter_buyback" domain="[('transaction_type', '=', 'buyback')]"/>
                <filter string="Return Loan" name="filter_return" domain="[('transaction_type', '=', 'return_loan')]"/>
                <filter string="Customer Inbound" name="filter_inbound" domain="[('transaction_type', '=', 'customer_inbound')]"/>
                <filter string="Loan Out" name="filter_loan_out" domain="[('transaction_type', '=', 'loan_out')]"/>
                <separator/>
                <filter string="Inbound" name="filter_direction_in" domain="[('direction', '=', 'inbound')]"/>
                <filter string="Outbound" name="filter_direction_out" domain="[('direction', '=', 'outbound')]"/>
                <separator/>
                <filter string="This Month" name="filter_month" domain="[('create_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Customer" name="groupby_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Container Type" name="groupby_container" context="{'group_by': 'container_spec_id'}"/>
                    <filter string="Transaction Type" name="groupby_type" context="{'group_by': 'transaction_type'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Container Transaction Action -->
    <record id="action_chemical_container_transaction" model="ir.actions.act_window">
        <field name="name">Container Transactions</field>
        <field name="res_model">chemical.container.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="chemical_container_transaction_view_search"/>
        <field name="context">{'search_default_filter_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No container transactions yet
            </p>
            <p>
                Container transactions are automatically created when processing drum returns,
                loans, and customer container movements.
            </p>
        </field>
    </record>
</odoo>
