<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tank Content Tree View -->
    <record id="view_tank_content_tree" model="ir.ui.view">
        <field name="name">chemical.tank.content.tree</field>
        <field name="model">chemical.tank.content</field>
        <field name="arch" type="xml">
            <tree string="Tank Contents" decoration-warning="state=='partial'" decoration-success="state=='full'" decoration-muted="state=='empty'">
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="lot_id" optional="show"/>
                <field name="quantity"/>
                <field name="tank_capacity"/>
                <field name="fill_percentage" widget="progressbar"/>
                <field name="state" widget="badge" decoration-success="state=='full'" decoration-warning="state=='partial'" decoration-info="state=='empty'" decoration-danger="state=='maintenance'"/>
                <field name="quality_status" widget="badge" decoration-success="quality_status=='approved'" decoration-warning="quality_status=='pending'" decoration-danger="quality_status in ('quarantine', 'rejected')"/>
                <field name="last_fill_date"/>
            </tree>
        </field>
    </record>

    <!-- Tank Content Form View -->
    <record id="view_tank_content_form" model="ir.ui.view">
        <field name="name">chemical.tank.content.form</field>
        <field name="model">chemical.tank.content</field>
        <field name="arch" type="xml">
            <form string="Tank Content">
                <header>
                    <button name="action_start_cleaning" type="object" string="Start Cleaning" class="btn-secondary" invisible="state != 'empty'"/>
                    <button name="action_complete_cleaning" type="object" string="Complete Cleaning" class="btn-primary" invisible="state != 'cleaning'"/>
                    <field name="state" widget="statusbar" statusbar_visible="empty,partial,full"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="history_count" string="History" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="location_id" placeholder="Select Tank"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Product Information">
                            <field name="product_id"/>
                            <field name="lot_id" domain="[('product_id', '=', product_id)]"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Quantity">
                            <field name="quantity"/>
                            <field name="tank_capacity"/>
                            <field name="fill_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Quality">
                            <field name="quality_status" widget="radio"/>
                            <field name="last_sample_date"/>
                            <field name="next_sample_date"/>
                        </group>
                        <group string="Dates">
                            <field name="last_fill_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Enter notes about tank contents..."/>
                        </page>
                        <page string="History" name="history">
                            <field name="history_ids" readonly="1">
                                <tree string="Tank History" decoration-success="operation_type=='fill'" decoration-warning="operation_type=='draw'">
                                    <field name="operation_date"/>
                                    <field name="operation_type"/>
                                    <field name="quantity"/>
                                    <field name="quantity_before"/>
                                    <field name="quantity_after"/>
                                    <field name="user_id"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Tank Content Kanban View -->
    <record id="view_tank_content_kanban" model="ir.ui.view">
        <field name="name">chemical.tank.content.kanban</field>
        <field name="model">chemical.tank.content</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="tank_capacity"/>
                <field name="fill_percentage"/>
                <field name="state"/>
                <field name="quality_status"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="location_id"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="label_selection" options="{'classes': {'empty': 'secondary', 'partial': 'warning', 'full': 'success', 'cleaning': 'info', 'maintenance': 'danger'}}"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="product_id"/>
                                    <div class="mt-2">
                                        <strong><field name="quantity"/> / <field name="tank_capacity"/></strong>
                                    </div>
                                    <field name="fill_percentage" widget="progressbar"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="quality_status" widget="badge" decoration-success="quality_status=='approved'" decoration-warning="quality_status=='pending'" decoration-danger="quality_status in ('quarantine', 'rejected')"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Tank Content Search View -->
    <record id="view_tank_content_search" model="ir.ui.view">
        <field name="name">chemical.tank.content.search</field>
        <field name="model">chemical.tank.content</field>
        <field name="arch" type="xml">
            <search string="Search Tank Contents">
                <field name="location_id"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <separator/>
                <filter name="filter_empty" string="Empty" domain="[('state', '=', 'empty')]"/>
                <filter name="filter_partial" string="Partial" domain="[('state', '=', 'partial')]"/>
                <filter name="filter_full" string="Full" domain="[('state', '=', 'full')]"/>
                <separator/>
                <filter name="filter_approved" string="Approved" domain="[('quality_status', '=', 'approved')]"/>
                <filter name="filter_pending_qc" string="Pending QC" domain="[('quality_status', '=', 'pending')]"/>
                <filter name="filter_quarantine" string="Quarantine" domain="[('quality_status', '=', 'quarantine')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_quality" string="Quality" context="{'group_by': 'quality_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tank Content Action -->
    <record id="action_tank_content" model="ir.actions.act_window">
        <field name="name">Tank Contents</field>
        <field name="res_model">chemical.tank.content</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_tank_content_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tank content record
            </p>
            <p>
                Track what products are stored in each tank, including quantities, lot numbers, and quality status.
            </p>
        </field>
    </record>

</odoo>
