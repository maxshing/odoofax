<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- IoT Point Tree View -->
    <record id="view_iot_point_tree" model="ir.ui.view">
        <field name="name">chemical.iot.point.tree</field>
        <field name="model">chemical.iot.point</field>
        <field name="arch" type="xml">
            <tree string="IoT Points" decoration-success="state=='active'" decoration-warning="state=='maintenance'" decoration-danger="state in ('offline', 'error')">
                <field name="name"/>
                <field name="description"/>
                <field name="point_type" widget="badge"/>
                <field name="location_type"/>
                <field name="pump_id" optional="show"/>
                <field name="workcenter_id" optional="show"/>
                <field name="tank_location_id" optional="show"/>
                <field name="last_reading"/>
                <field name="last_reading_time"/>
                <field name="state" widget="badge" decoration-success="state=='active'" decoration-warning="state=='maintenance'" decoration-danger="state in ('offline', 'error')"/>
            </tree>
        </field>
    </record>

    <!-- IoT Point Form View -->
    <record id="view_iot_point_form" model="ir.ui.view">
        <field name="name">chemical.iot.point.form</field>
        <field name="model">chemical.iot.point</field>
        <field name="arch" type="xml">
            <form string="IoT Point">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,maintenance,offline"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_readings" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="reading_count" string="Readings" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g., FIT-P1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Sensor Configuration">
                            <field name="description"/>
                            <field name="point_type"/>
                            <field name="location_type"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Equipment Link">
                            <field name="pump_id" invisible="location_type != 'pump'"/>
                            <field name="workcenter_id" invisible="location_type != 'filler'"/>
                            <field name="tank_location_id" invisible="location_type not in ('tank_inlet', 'tank_outlet', 'tank_level')"/>
                        </group>
                    </group>
                    <group>
                        <group string="Latest Reading">
                            <field name="last_reading"/>
                            <field name="last_reading_time"/>
                        </group>
                        <group string="Cross-Check Validation">
                            <field name="cross_check_point_id"/>
                            <field name="variance_threshold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recent Readings" name="readings">
                            <field name="reading_ids" readonly="1">
                                <tree string="Readings" decoration-success="cross_check_status=='matched'" decoration-warning="cross_check_status=='variance'" decoration-danger="cross_check_status=='alert'">
                                    <field name="reading_time"/>
                                    <field name="value"/>
                                    <field name="source_tank_id"/>
                                    <field name="batch_reference"/>
                                    <field name="cross_check_status" widget="badge"/>
                                    <field name="variance_pct"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- IoT Point Kanban View -->
    <record id="view_iot_point_kanban" model="ir.ui.view">
        <field name="name">chemical.iot.point.kanban</field>
        <field name="model">chemical.iot.point</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="point_type">
                <field name="name"/>
                <field name="description"/>
                <field name="point_type"/>
                <field name="state"/>
                <field name="last_reading"/>
                <field name="last_reading_time"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="state" widget="label_selection" options="{'classes': {'active': 'success', 'maintenance': 'warning', 'offline': 'secondary', 'error': 'danger'}}"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="description"/>
                                    <div class="mt-2">
                                        <strong>Last: <field name="last_reading"/></strong>
                                    </div>
                                    <small class="text-muted">
                                        <field name="last_reading_time"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- IoT Point Search View -->
    <record id="view_iot_point_search" model="ir.ui.view">
        <field name="name">chemical.iot.point.search</field>
        <field name="model">chemical.iot.point</field>
        <field name="arch" type="xml">
            <search string="Search IoT Points">
                <field name="name"/>
                <field name="description"/>
                <field name="pump_id"/>
                <field name="workcenter_id"/>
                <field name="tank_location_id"/>
                <separator/>
                <filter name="filter_flow" string="Flow Meters" domain="[('point_type', '=', 'flow')]"/>
                <filter name="filter_level" string="Level Sensors" domain="[('point_type', '=', 'level')]"/>
                <filter name="filter_pressure" string="Pressure Sensors" domain="[('point_type', '=', 'pressure')]"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="filter_offline" string="Offline/Error" domain="[('state', 'in', ('offline', 'error'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_type" string="Sensor Type" context="{'group_by': 'point_type'}"/>
                    <filter name="group_by_location" string="Location Type" context="{'group_by': 'location_type'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- IoT Point Action -->
    <record id="action_iot_point" model="ir.actions.act_window">
        <field name="name">IoT Points</field>
        <field name="res_model">chemical.iot.point</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_iot_point_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first IoT measurement point
            </p>
            <p>
                IoT points represent physical sensors in your plant: flow meters, level transmitters, pressure sensors, etc.
            </p>
        </field>
    </record>

    <!-- IoT Reading Tree View -->
    <record id="view_iot_reading_tree" model="ir.ui.view">
        <field name="name">chemical.iot.reading.tree</field>
        <field name="model">chemical.iot.reading</field>
        <field name="arch" type="xml">
            <tree string="IoT Readings" decoration-success="cross_check_status=='matched'" decoration-warning="cross_check_status=='variance'" decoration-danger="cross_check_status=='alert'">
                <field name="reading_time"/>
                <field name="point_id"/>
                <field name="value"/>
                <field name="uom_id"/>
                <field name="source_tank_id"/>
                <field name="batch_reference"/>
                <field name="cross_check_status" widget="badge" optional="show"/>
                <field name="variance_pct" optional="show"/>
                <field name="stock_move_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- IoT Reading Form View -->
    <record id="view_iot_reading_form" model="ir.ui.view">
        <field name="name">chemical.iot.reading.form</field>
        <field name="model">chemical.iot.reading</field>
        <field name="arch" type="xml">
            <form string="IoT Reading">
                <sheet>
                    <group>
                        <group string="Reading Details">
                            <field name="point_id"/>
                            <field name="reading_time"/>
                            <field name="value"/>
                            <field name="uom_id"/>
                        </group>
                        <group string="Process Context">
                            <field name="source_tank_id"/>
                            <field name="dest_tank_id"/>
                            <field name="batch_reference"/>
                            <field name="stock_move_id"/>
                        </group>
                    </group>
                    <group string="Cross-Check Validation">
                        <field name="cross_check_status" widget="radio"/>
                        <field name="variance_pct"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- IoT Reading Search View -->
    <record id="view_iot_reading_search" model="ir.ui.view">
        <field name="name">chemical.iot.reading.search</field>
        <field name="model">chemical.iot.reading</field>
        <field name="arch" type="xml">
            <search string="Search Readings">
                <field name="point_id"/>
                <field name="batch_reference"/>
                <field name="source_tank_id"/>
                <separator/>
                <filter name="filter_matched" string="Matched" domain="[('cross_check_status', '=', 'matched')]"/>
                <filter name="filter_variance" string="Variance" domain="[('cross_check_status', '=', 'variance')]"/>
                <filter name="filter_alert" string="Alerts" domain="[('cross_check_status', '=', 'alert')]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('reading_time', '>=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_point" string="IoT Point" context="{'group_by': 'point_id'}"/>
                    <filter name="group_by_tank" string="Source Tank" context="{'group_by': 'source_tank_id'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'reading_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- IoT Reading Action -->
    <record id="action_iot_reading" model="ir.actions.act_window">
        <field name="name">IoT Readings</field>
        <field name="res_model">chemical.iot.reading</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="search_view_id" ref="view_iot_reading_search"/>
        <field name="context">{'search_default_filter_today': 1}</field>
    </record>

    <!-- Flow Engine Tree View -->
    <record id="view_flow_engine_tree" model="ir.ui.view">
        <field name="name">chemical.flow.engine.tree</field>
        <field name="model">chemical.flow.engine</field>
        <field name="arch" type="xml">
            <tree string="Flow Engines">
                <field name="name"/>
                <field name="state" widget="badge" decoration-success="state=='running'" decoration-warning="state=='paused'" decoration-danger="state=='error'"/>
                <field name="last_run"/>
                <field name="processed_count"/>
                <field name="alert_count"/>
            </tree>
        </field>
    </record>

    <!-- Flow Engine Action -->
    <record id="action_flow_engine" model="ir.actions.act_window">
        <field name="name">Flow-to-Stock Engine</field>
        <field name="res_model">chemical.flow.engine</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
