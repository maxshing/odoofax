<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Partner Form to Show Container Ledger -->
    <record id="view_partner_form_container_ledger" model="ir.ui.view">
        <field name="name">res.partner.form.container.ledger</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <!-- Add button box for quick access -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_container_ledger" type="object"
                        class="oe_stat_button" icon="fa-cubes"
                        invisible="not is_company and parent_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="total_containers_loaned" class="me-1"/>
                            <span>/ </span>
                            <field name="total_containers_customer_owned"/>
                        </span>
                        <span class="o_stat_text">借出 / 自備桶</span>
                    </div>
                </button>
                <button name="action_return_drums" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        string="Return Drums"
                        invisible="not is_company and parent_id"/>
            </xpath>
            
            <!-- Add Container Ledger tab in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Container Ledger (容器存摺)" name="container_ledger"
                      invisible="not is_company and parent_id">
                    <group>
                        <group string="Container Balance Summary">
                            <field name="total_containers_loaned" readonly="1"/>
                            <field name="total_containers_customer_owned" readonly="1"/>
                            <field name="total_container_deposit" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    
                    <field name="container_ledger_ids" readonly="1" nolabel="1">
                        <list>
                            <field name="container_spec_id"/>
                            <field name="balance_loaned"/>
                            <field name="balance_customer_owned"/>
                            <field name="period_loaned"/>
                            <field name="period_returned"/>
                            <field name="total_deposit"/>
                            <field name="last_movement_date"/>
                        </list>
                    </field>
                    
                    <group class="oe_subtotal_footer oe_right">
                        <div class="oe_inline">
                            <label for="total_container_deposit"/>
                            <field name="total_container_deposit" class="oe_subtotal_footer_separator" widget="monetary"/>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
