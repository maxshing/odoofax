<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- BLENDING ORDER ACTIONS                                       -->
    <!-- ============================================================ -->

    <!-- Action to view blending orders -->
    <record id="action_mrp_production_blending" model="ir.actions.act_window">
        <field name="name">Blending Orders</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="domain">[('is_blending_order', '=', True)]</field>
        <field name="context">{'default_is_blending_order': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No blending orders yet
            </p>
            <p>
                Create a manufacturing order with a blending recipe BOM to see it here.
            </p>
        </field>
    </record>

</odoo>
