<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- MRP WORKCENTER - RFID AUTHORIZATION EXTENSION               -->
    <!-- ============================================================ -->

    <!-- Extend Work Center Form View -->
    <record id="view_mrp_workcenter_form_extension" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.chemical.extension</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook position="inside">
                    <page string="Shop Floor Authorization" name="shop_floor_auth">
                        <group>
                            <group string="RFID Configuration">
                                <field name="require_rfid_auth" widget="boolean_toggle"/>
                                <field name="machine_state" widget="badge" decoration-success="machine_state=='unlocked'" decoration-warning="machine_state=='running'" decoration-danger="machine_state in ('locked', 'error')"/>
                            </group>
                            <group string="Last Authorization">
                                <field name="last_auth_employee_id"/>
                                <field name="last_auth_time"/>
                            </group>
                        </group>
                        <group string="Authorized Operators" invisible="not require_rfid_auth">
                            <field name="authorized_employee_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                        </group>
                        <div class="alert alert-info" role="alert" invisible="not require_rfid_auth">
                            <strong>RFID Authorization Enabled</strong>
                            <p>Only the operators listed above can unlock this machine by scanning their RFID badge.</p>
                            <p>To add an operator, ensure they have a Badge ID set in their employee record (HR &gt; Employees &gt; [Employee] &gt; Badge ID).</p>
                        </div>
                    </page>
                </notebook>
            </xpath>
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_view_authorized_employees" type="object" class="oe_stat_button" icon="fa-users" invisible="not require_rfid_auth">
                    <field name="authorized_count" string="Authorized" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Extend Work Center Tree View -->
    <record id="view_mrp_workcenter_tree_extension" model="ir.ui.view">
        <field name="name">mrp.workcenter.tree.chemical.extension</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="require_rfid_auth" optional="show"/>
                <field name="machine_state" widget="badge" optional="show" decoration-success="machine_state=='unlocked'" decoration-warning="machine_state=='running'" decoration-danger="machine_state in ('locked', 'error')"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- MRP WORKORDER - AUTHORIZATION TRACKING EXTENSION            -->
    <!-- ============================================================ -->

    <!-- Extend Work Order Form View -->
    <record id="view_mrp_workorder_form_extension" model="ir.ui.view">
        <field name="name">mrp.workorder.form.chemical.extension</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_workorder_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Authorization Details" name="auth_details" invisible="not rfid_required">
                    <group>
                        <field name="rfid_required" invisible="1"/>
                        <field name="is_authorized" widget="boolean"/>
                        <field name="authorized_by"/>
                    </group>
                    <group>
                        <field name="auth_timestamp"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend Work Order Tree View -->
    <record id="view_mrp_workorder_tree_extension" model="ir.ui.view">
        <field name="name">mrp.workorder.tree.chemical.extension</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_workorder_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="authorized_by" optional="hide"/>
                <field name="auth_timestamp" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- HR EMPLOYEE - BADGE ID HIGHLIGHT                            -->
    <!-- ============================================================ -->

    <!-- Extend Employee Form to highlight Badge ID -->
    <record id="view_hr_employee_form_badge_extension" model="ir.ui.view">
        <field name="name">hr.employee.form.badge.extension</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="string">Badge ID (RFID)</attribute>
            </xpath>
        </field>
    </record>

</odoo>
