<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- SHOP FLOOR AUTHORIZATION ACTION                             -->
    <!-- ============================================================ -->

    <!-- Action to view work centers with RFID authorization -->
    <record id="action_mrp_workcenter_rfid" model="ir.actions.act_window">
        <field name="name">RFID Work Centers</field>
        <field name="res_model">mrp.workcenter</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="domain">[('require_rfid_auth', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No RFID-enabled work centers
            </p>
            <p>
                Enable RFID authorization on work centers to control machine access.
            </p>
        </field>
    </record>

</odoo>
