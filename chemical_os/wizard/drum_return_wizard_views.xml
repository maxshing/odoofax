<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Drum Return Wizard Form View -->
    <record id="chemical_drum_return_wizard_view_form" model="ir.ui.view">
        <field name="name">chemical.drum.return.wizard.view.form</field>
        <field name="model">chemical.drum.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Process Drum Return">
                <group>
                    <group string="Return Details">
                        <field name="partner_id"/>
                        <field name="container_spec_id"/>
                        <field name="quantity"/>
                        <field name="return_mode" widget="radio"/>
                    </group>
                    <group string="Current Balances">
                        <field name="current_loaned" readonly="1"/>
                        <field name="current_customer_owned" readonly="1"/>
                    </group>
                </group>
                
                <!-- Show buyback amount for Mode A -->
                <group string="Buyback Details" invisible="return_mode != 'buyback'">
                    <group>
                        <field name="buyback_unit_price" readonly="1"/>
                        <field name="total_buyback_amount" readonly="1" class="oe_subtotal_footer_separator"/>
                    </group>
                </group>
                
                <group>
                    <field name="notes" placeholder="Additional notes..."/>
                </group>
                
                <footer>
                    <button name="action_process_return" type="object" 
                            string="Process Return" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Drum Return Wizard Action -->
    <record id="action_chemical_drum_return_wizard" model="ir.actions.act_window">
        <field name="name">Process Drum Return</field>
        <field name="res_model">chemical.drum.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
