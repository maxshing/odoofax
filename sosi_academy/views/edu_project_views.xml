<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Form View -->
    <record id="view_edu_project_form" model="ir.ui.view">
        <field name="name">edu.project.form</field>
        <field name="model">edu.project</field>
        <field name="arch" type="xml">
            <form string="Student Project">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,ongoing,finished"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="school_id"/>
                            <field name="teacher"/>
                            <field name="topic"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="related_product"/>
                            <field name="dataset_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="students" placeholder="Enter student names, one per line..."/>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Results">
                            <group>
                                <field name="result_url" widget="url"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Project Tree View -->
    <record id="view_edu_project_tree" model="ir.ui.view">
        <field name="name">edu.project.tree</field>
        <field name="model">edu.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="school_id"/>
                <field name="topic"/>
                <field name="teacher"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Project Kanban View -->
    <record id="view_edu_project_kanban" model="ir.ui.view">
        <field name="name">edu.project.kanban</field>
        <field name="model">edu.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="name"/>
                <field name="school_id"/>
                <field name="topic"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="school_id"/>
                        <field name="topic" widget="badge"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Project Action -->
    <record id="action_edu_project" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">edu.project</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
