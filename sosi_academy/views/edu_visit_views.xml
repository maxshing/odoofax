<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Visit Form View -->
    <record id="view_edu_visit_form" model="ir.ui.view">
        <field name="name">edu.visit.form</field>
        <field name="model">edu.visit</field>
        <field name="arch" type="xml">
            <form string="Factory Visit">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" 
                            invisible="state != 'planned'" class="btn-primary"/>
                    <button name="action_done" string="Mark Done" type="object"
                            invisible="state != 'confirmed'" class="btn-primary"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,confirmed,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="school_id"/>
                            <field name="date"/>
                            <field name="student_count"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activities">
                            <field name="activities" placeholder="Describe the visit activities..."/>
                        </page>
                        <page string="Photos">
                            <field name="photos" widget="many2many_binary"/>
                        </page>
                        <page string="Remarks">
                            <field name="remark"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Visit Tree View -->
    <record id="view_edu_visit_tree" model="ir.ui.view">
        <field name="name">edu.visit.tree</field>
        <field name="model">edu.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="school_id"/>
                <field name="student_count"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Visit Calendar View -->
    <record id="view_edu_visit_calendar" model="ir.ui.view">
        <field name="name">edu.visit.calendar</field>
        <field name="model">edu.visit</field>
        <field name="arch" type="xml">
            <calendar date_start="date" color="state">
                <field name="school_id"/>
                <field name="student_count"/>
            </calendar>
        </field>
    </record>

    <!-- Visit Action -->
    <record id="action_edu_visit" model="ir.actions.act_window">
        <field name="name">Factory Visits</field>
        <field name="res_model">edu.visit</field>
        <field name="view_mode">calendar,list,form</field>
    </record>
</odoo>
