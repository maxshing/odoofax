<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- School Form View -->
    <record id="view_edu_school_form" model="ir.ui.view">
        <field name="name">edu.school.form</field>
        <field name="model">edu.school</field>
        <field name="arch" type="xml">
            <form string="School">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_projects" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                        <button name="action_view_visits" type="object"
                                class="oe_stat_button" icon="fa-building">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="region"/>
                        </group>
                        <group>
                            <field name="contact"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- School Tree View -->
    <record id="view_edu_school_tree" model="ir.ui.view">
        <field name="name">edu.school.tree</field>
        <field name="model">edu.school</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="region"/>
                <field name="contact"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="project_count"/>
            </list>
        </field>
    </record>

    <!-- School Search View -->
    <record id="view_edu_school_search" model="ir.ui.view">
        <field name="name">edu.school.search</field>
        <field name="model">edu.school</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="contact"/>
                <filter string="North" name="north" domain="[('region','=','north')]"/>
                <filter string="Central" name="central" domain="[('region','=','central')]"/>
                <filter string="South" name="south" domain="[('region','=','south')]"/>
                <group expand="0" string="Group By">
                    <filter string="Region" name="group_region" context="{'group_by':'region'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- School Action -->
    <record id="action_edu_school" model="ir.actions.act_window">
        <field name="name">Schools</field>
        <field name="res_model">edu.school</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first school partner!
            </p>
        </field>
    </record>
</odoo>
