<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dataset Form View -->
    <record id="view_edu_dataset_form" model="ir.ui.view">
        <field name="name">edu.dataset.form</field>
        <field name="model">edu.dataset</field>
        <field name="arch" type="xml">
            <form string="Educational Dataset">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="tags"/>
                        </group>
                        <group>
                            <field name="source_model"/>
                            <field name="record_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="file" filename="file_name"/>
                            <field name="file_name" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Used by Projects">
                            <field name="project_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="school_id"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Dataset Tree View -->
    <record id="view_edu_dataset_tree" model="ir.ui.view">
        <field name="name">edu.dataset.tree</field>
        <field name="model">edu.dataset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
                <field name="record_count"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>

    <!-- Dataset Action -->
    <record id="action_edu_dataset" model="ir.actions.act_window">
        <field name="name">Datasets</field>
        <field name="res_model">edu.dataset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
