<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_package_form" model="ir.ui.view">
        <field name="name">service.package.form</field>
        <field name="model">service.package</field>
        <field name="arch" type="xml">
            <form string="Service Package">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-briefcase"
                                name="action_view_projects" type="object">
                            <field name="project_count" widget="statinfo" string="Projects"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="target_customer"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="price_monthly"/>
                            <field name="implementation_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Modules">
                            <group>
                                <field name="module_auto_quote"/>
                                <field name="module_auto_purchase"/>
                                <field name="module_rfid"/>
                                <field name="module_scada"/>
                                <field name="module_iot_api"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_service_package_tree" model="ir.ui.view">
        <field name="name">service.package.tree</field>
        <field name="model">service.package</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="target_customer"/>
                <field name="price_monthly"/>
                <field name="implementation_days"/>
                <field name="project_count"/>
            </list>
        </field>
    </record>

    <record id="action_service_package" model="ir.actions.act_window">
        <field name="name">Service Packages</field>
        <field name="res_model">service.package</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
