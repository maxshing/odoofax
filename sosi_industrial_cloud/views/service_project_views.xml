<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_project_form" model="ir.ui.view">
        <field name="name">service.project.form</field>
        <field name="model">service.project</field>
        <field name="arch" type="xml">
            <form string="Service Project">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,complete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-plug"
                                name="action_view_integrations" type="object">
                            <field name="integration_count" widget="statinfo" string="Integrations"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="package_id"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="monthly_fee"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Integrations">
                            <field name="integration_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="active"/>
                                    <field name="last_sync"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_service_project_tree" model="ir.ui.view">
        <field name="name">service.project.tree</field>
        <field name="model">service.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="package_id"/>
                <field name="start_date"/>
                <field name="status"/>
                <field name="monthly_fee"/>
            </list>
        </field>
    </record>

    <record id="view_service_project_kanban" model="ir.ui.view">
        <field name="name">service.project.kanban</field>
        <field name="model">service.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status">
                <field name="customer_id"/>
                <field name="package_id"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <field name="customer_id" class="fw-bold"/>
                        <field name="package_id"/>
                        <field name="monthly_fee" widget="monetary"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_service_project" model="ir.actions.act_window">
        <field name="name">Implementation Projects</field>
        <field name="res_model">service.project</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
